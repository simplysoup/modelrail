# Cloud SQL Postgres for the MLflow backend store.
# db-f1-micro is the smallest tier: fine for a portfolio MLflow backend
# with a handful of runs, and the cheapest way to keep the backend real
# instead of a local SQLite file. Private IP only, no public exposure.
# The MLflow database password is generated by Terraform and stored in
# state; it is never committed. Rotate it by tainting the password
# resource, not by editing any file.

resource "random_password" "mlflow_db" {
  length  = 32
  special = false
}

resource "google_sql_database_instance" "mlflow" {
  name                = var.cloudsql_instance_name
  project             = var.project_id
  region              = var.region
  database_version    = var.cloudsql_database_version
  deletion_protection = false

  settings {
    tier = var.cloudsql_tier

    ip_configuration {
      ipv4_enabled    = false
      private_network = google_compute_network.modelrail.id
    }

    backup_configuration {
      enabled = true
    }
  }

  depends_on = [
    google_project_service.apis,
    google_service_networking_connection.private_vpc_connection,
  ]
}

resource "google_sql_database" "mlflow" {
  name     = var.cloudsql_database_name
  project  = var.project_id
  instance = google_sql_database_instance.mlflow.name
}

resource "google_sql_user" "mlflow" {
  name     = var.mlflow_db_user
  project  = var.project_id
  instance = google_sql_database_instance.mlflow.name
  password = random_password.mlflow_db.result
}
